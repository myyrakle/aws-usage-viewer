# AWS credentials for reading the CUR export from S3 (used by curhouse sync)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Metabase admin (created on first provision run)
MB_ADMIN_EMAIL=you@example.com
MB_ADMIN_PASSWORD=ChangeMe#12345

# Existing host ClickHouse. CURHOUSE_CH_USER/PASSWORD drive BOTH the sync CLI
# and the Metabase datasource. Set these if your ClickHouse requires auth.
# CURHOUSE_CH_HOST=host.docker.internal
# CURHOUSE_CH_PORT=8123
# CURHOUSE_CH_USER=default
# CURHOUSE_CH_PASSWORD=
