# AWS credentials for reading the CUR export from S3 (used by curhouse sync)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Metabase admin (created on first provision run)
MB_ADMIN_EMAIL=you@example.com
MB_ADMIN_PASSWORD=ChangeMe#12345

# Existing host ClickHouse (defaults shown; override only if not on the host)
# CURHOUSE_CH_HOST=host.docker.internal
# CURHOUSE_CH_PORT=8123
# CURHOUSE_CH_USER=default   # drives both the sync CLI and the Metabase datasource
# CURHOUSE_CH_PASSWORD=
# CH_PASSWORD=            # ClickHouse password for the Metabase datasource (usually same/empty)
